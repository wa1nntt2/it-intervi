# Production Environment Variables
# Скопируйте этот файл в .env и заполните значениями для production

# === Database ===
# Для production рекомендуется использовать PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/interview_trainer
DATABASE_URL=sqlite:///./interview_trainer.db

# === Security - ОБЯЗАТЕЛЬНО измените! ===
# Сгенерируйте случайный ключ: openssl rand -hex 32
SECRET_KEY=

# JWT настройки
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === CORS settings ===
# Укажите домен вашего frontend в production
CORS_ORIGINS=https://yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# === Rate limiting ===
RATE_LIMIT_PER_MINUTE=10

# === App Settings ===
DEBUG=false

# === Pagination ===
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# === Sessions ===
QUESTIONS_PER_SESSION=20
MIN_QUESTIONS_IN_SESSION=5

# === Cache ===
CACHE_CAPACITY=100
